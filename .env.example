# API OpenAI (développement / tests)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optionnel — modèle playground / production (défaut gpt-5.6-luna) :
# OPENAI_MODEL=gpt-5.6-luna

# Reasoning effort pour GPT-5.x : none | minimal | low | medium | high | xhigh
# OPENAI_REASONING_EFFORT=low

# Optionnel — modèle épinglé pour expériences pédagogiques (batch eval, etc.)
# Si absent, réutilise OPENAI_MODEL / le défaut.
# OPENAI_EVAL_MODEL=gpt-5.6-luna
