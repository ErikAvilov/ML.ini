# Fournisseur IA : gemini (défaut) | openai
AI_PROVIDER=gemini

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optionnel — modèle playground / production (défaut gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optionnel — modèle épinglé pour expériences pédagogiques (batch eval)
# GEMINI_EVAL_MODEL=gemini-2.5-flash

# --- Fallback OpenAI (AI_PROVIDER=openai) ---
# https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_REASONING_EFFORT=low
# OPENAI_EVAL_MODEL=gpt-5.6-luna

# --- Neon PostgreSQL (runtime — server-only, never NEXT_PUBLIC_*) ---
# Pooled connection for runtime / serverless
DATABASE_URL=
# Direct connection for migrations / admin scripts
DATABASE_URL_DIRECT=

# --- Better Auth (runtime — server-only) ---
BETTER_AUTH_SECRET=
# App origin used by Better Auth
# Local: http://localhost:3000
# Production: https://mlini.dev
BETTER_AUTH_URL=

# --- OAuth (runtime — server-only) ---
# Callbacks:
#   Local:      http://localhost:3000/api/auth/callback/google|github
#   Production: https://mlini.dev/api/auth/callback/google|github
# Prefer a GitHub OAuth App (not a GitHub App). Scopes: read:user + user:email only.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# =============================================================================
# MIGRATION ONLY — NOT REQUIRED BY MLINI RUNTIME
# Historical Supabase → Neon tooling (`scripts/migrate-supabase-to-neon.ts`).
# Never deploy these to Vercel. Never use NEXT_PUBLIC_* for DB credentials.
# =============================================================================
# SUPABASE_SOURCE_DATABASE_URL=
# SUPABASE_POOLER_REGION=eu-central-1
# SUPABASE_POOLER_HOST=
# SUPABASE_POOLER_PORT=5432
