{
  "name": "mlini",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "npx tsx scripts/check-safe-next.ts && npx tsx scripts/check-username.ts && npx tsx scripts/check-cloud-progression.ts && npx tsx scripts/check-account-delete.ts && npx tsx scripts/check-migration-transform.ts && npx tsx scripts/check-github-auth.ts",
    "db:ensure-better-auth-schema": "npx tsx --env-file=.env --env-file=.env.local scripts/ensure-better-auth-schema.ts",
    "db:migrate:neon": "npx tsx --env-file=.env --env-file=.env.local scripts/apply-neon-migrations.ts --only=001",
    "db:migrate:neon:triggers": "npx tsx --env-file=.env --env-file=.env.local scripts/apply-neon-migrations.ts --only=002",
    "migrate:supabase-to-neon:dry": "npx tsx --env-file=.env --env-file=.env.local scripts/migrate-supabase-to-neon.ts --dry-run",
    "migrate:supabase-to-neon": "npx tsx --env-file=.env --env-file=.env.local scripts/migrate-supabase-to-neon.ts --apply --install-triggers",
    "auth:generate": "BETTER_AUTH_USE_DIRECT=1 npx auth@latest generate --config src/lib/better-auth/auth.ts --output db/better-auth-schema.sql -y",
    "auth:migrate": "BETTER_AUTH_USE_DIRECT=1 npx auth@latest migrate --config src/lib/better-auth/auth.ts --yes",
    "auth:verify": "npx tsx --env-file=.env --env-file=.env.local scripts/verify-better-auth-neon.ts",
    "eval:batch": "tsx --env-file=.env scripts/run-batch-eval.ts"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "better-auth": "^1.7.4",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "openai": "^7.10.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
